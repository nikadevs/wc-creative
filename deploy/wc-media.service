[Unit]
Description=WC Creative media server (creatives on our disk)
After=network.target

[Service]
User=www-data
Group=www-data
EnvironmentFile=/opt/wc-creative/.env
Environment=MEDIA_DIR=/var/lib/wc-creative/media
Environment=MEDIA_PORT=8787
WorkingDirectory=/opt/wc-creative/app
ExecStart=/usr/bin/node server/media-server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
